# Approx Cornell Room
camera pin_hole
  pos 0.0 0.0 800.0
  look 0.0 0.0 0.0
  up 0.0 1.0 0.0

scene
  # Ceiling
  object transformed
    object simple
      rectangle 555 555
      lambertian color 1.0 1.0 1.0
    transform {
      rotate_x -3.14159
      translate 0.0 277.0 0.0
    }
  # Floor
  object transformed
    object simple
      rectangle 555 555
      lambertian color 1.0 1.0 1.0
    transform {
      translate 0.0 -277.0 0.0
    }
  # Right
  object transformed
    object simple
      rectangle 555.0 555.0
      lambertian color 1.0 0 0
    transform {
      rotate_z -1.5708
      translate -277.0 0.0 0.0
    }
  # Left
  object transformed
    object simple
      rectangle 555.0 555.0
      lambertian color 0 1 0
    transform {
      rotate_z 1.5708
      translate 277.0 0.0 0.0
    }
  # Back
  object transformed
    object simple
      rectangle 555.0 555.0
      lambertian color 1 1 1
    transform {
      rotate_x 1.5708
      translate 0.0 0.0 -277.0
    }

  # small box
  object transformed
    object simple
      aabox 165.0 330.0 165.0
      lambertian color 1 1 1
    transform {
#     rotate_y (-15.0 * PI / 180.0)
      rotate_y -0.262
      translate 80.0 -150.0 -100.0
    }

  # tall box
  object transformed
    object simple
      aabox 165.0 165.0 165.0
      lambertian color 1 1 1
    transform {
#     rotate_y (18.0 * PI / 180.0)
      rotate_y 0.314
      translate -100.0 -195.0 100.0
    }

  object transformed
    object simple
      rectangle 130.0 105.0
      diffuse_light color 15.0 15.0 15.0
    transform {
#      rotate_y PI
      rotate_y 3.1416
      translate 0.0 276.0 0.0
    }
