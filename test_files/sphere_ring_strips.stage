# A sphere on a floor, ringed by ten lamps whose colours run once round the hue wheel, under
# late-afternoon daylight.
#
#   --integrator path --renderer mt --threads 8 --seed 0 --fov 40
#   --samples_ppx 256 --max_depth 4 --output_width 512 --output_height 512
#
# Each lamp is a white, shallow housing standing upright on the floor, its inner face turned towards
# the centre; the emitting panel sits a little back from that face, framed by a rim of the housing.
# The panels are long, low rectangles, 0.01 × 0.07, like the source of `floor_strip.stage`.
# Ten lamps stand on a circle of radius 0.16, 36° apart; against a pitch of 0.1 along
# the circle, a gap of about 0.03 separates two housings. Panel k has hue 36°·k at full
# saturation, so every azimuth of the sphere is lit mostly by the lamp facing it and the floor
# carries a ring of coloured shadows behind it.
#
# The sphere has radius 0.05 and rests 0.0002 above the floor. White, so the colour it shows is the
# colour of the light it receives.
#
# The camera stands outside the ring and above it, and sees the backs of the near housings. The
# rim lifts each panel 0.0015 above the floor, an eighth of its height: the floor at the foot of a
# lamp is still where the uniform-area draw of a `rectangle` is noisiest, as in
# `floor_strip.stage` — see `ideas/rectangle_spherique.md` §4 —, but no longer at d → 0.

camera pin_hole
  pos 0.0 0.25 0.46
  look 0.0 0.03 0.0
  up 0.0 1.0 0.0

scene

  # Late-afternoon daylight, in two parts.
  #
  # The sky: `background_infinite` blends its first colour, straight down, into its second,
  # straight up, linearly in the y of the direction. A warm first colour and a deep blue second
  # one give a zenith that is blue and a horizon, halfway, that is the orange of a low sun. Below
  # the horizon the floor hides the sky, so only the upper half of that blend is ever seen.
  light background_infinite
    color 0.36 0.15 0.045
    color 0.024 0.045 0.135

  # The sun, 8° above the horizon, behind the sphere and to the left of the image, so the sphere
  # and the panels cast long shadows towards the camera. It is an emissive sphere, and therefore an
  # `AreaLight` sampled within the cone it subtends: the real sun is a disk 0.53° across, and its
  # shadows have a soft edge — a penumbra 0.53° wide, about 0.0093 here behind a blocker 1 away.
  #
  # Size. The cone a sphere subtends is bounded by the lines of sight tangent to it, and a tangent
  # is perpendicular to the radius at its point of contact: centre, eye and contact point make a
  # right triangle whose hypotenuse is d, so sin θmax = r / d. A half-angle of 0.265° at
  # d = 20.19 from the origin gives r = d · sin(0.265°) = 0.0934. The sun is far enough that its direction barely changes across the scene: the ring's
  # 0.32 turns it by less than one degree.
  #
  # Radiance. A surface facing it receives E = L · Ω, with Ω = 2π(1 − cos θmax) = 6.72·10⁻⁵ sr the
  # solid angle of the disk. The radiance below is chosen for E ≈ (6, 3.3, 1.5): 0.8 in red on
  # the floor, which it reaches at 8°. The cone draw makes this size cheap — its density is constant
  # over the disk, so a sun this small is no noisier than a point light.
  object transformed
    object simple
      sphere 0.0934
      diffuse_light color 89000.0 49000.0 22300.0
    transform {
      translate 12.0 2.78 -16.0
    }

  # The floor, at y = 0, large enough that the frame never reaches its edge.
  object simple
    rectangle 4 4
    lambertian color 0.6 0.6 0.6

  # The sphere, centred on the vertical axis.
  object transformed
    object simple
      sphere 0.05
      lambertian color 0.8 0.8 0.8
    transform {
      translate 0.0 0.0502 0.0
    }

  # The ten lamps. Each is a white housing (albedo 0.9) whose inner face carries the emitting panel, sunk a
  # little into it and framed by a rim.
  #
  # A lamp is described in its own frame and then placed. In that frame the front of the housing
  # is the plane x = 0, facing -X, centred on the origin; the housing runs behind it to x = 0.004.
  #
  #   housing  0.004 deep, 0.0130 high, 0.0730 long: the panel's 0.01 × 0.07
  #            plus a rim of 0.0015 on all four sides
  #   recess   the panel's own outline, 0.0005 deep; the box cut from the housing reaches
  #            0.0005 in front of it and 0.001 behind, so no face of the cut lies in the
  #            plane of the housing's front. In a `.stage` file, `csg substraction` removes
  #            every element from the **last** one, so the cut is listed before the housing
  #            (`SceneBuilderVisitor::pop_csg_elems`)
  #   panel    a `rectangle` 0.01 × 0.07, at x = 0.0005, the bottom of the recess. It fills the
  #            recess exactly, so the cavity behind it is closed to every ray: the panel is not
  #            coplanar with any face of the housing, and the one face a ray can reach is the
  #            emitting one.
  #
  # The panel's quarter turn about z stands the authored rectangle up, normal along -X, first
  # side as its height. The lamp at azimuth φ stands at 0.16·(sin φ, 0, cos φ) and must face the
  # centre, its normal along -(sin φ, 0, cos φ); a turn of φ − π/2 about y carries -X there.
  # Azimuth 0 faces the camera; increasing φ runs towards +X, which `Matrix4::look_at` puts on the
  # left of the image (see `cornell_box_exact.stage`). The housing's lower face is 0.000002 above
  # the floor, so the two are never coplanar.

  # Lamp 0, azimuth 0°, hue 0°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 30.0 0.0 0.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y -1.57079633
      translate 0.00000000 0.006502 0.16000000
    }

  # Lamp 1, azimuth 36°, hue 36°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 30.0 18.0 0.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y -0.94247780
      translate 0.09404564 0.006502 0.12944272
    }

  # Lamp 2, azimuth 72°, hue 72°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 24.0 30.0 0.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y -0.31415927
      translate 0.15216904 0.006502 0.04944272
    }

  # Lamp 3, azimuth 108°, hue 108°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 6.0 30.0 0.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y 0.31415927
      translate 0.15216904 0.006502 -0.04944272
    }

  # Lamp 4, azimuth 144°, hue 144°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 0.0 30.0 12.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y 0.94247780
      translate 0.09404564 0.006502 -0.12944272
    }

  # Lamp 5, azimuth 180°, hue 180°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 0.0 30.0 30.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y 1.57079633
      translate 0.00000000 0.006502 -0.16000000
    }

  # Lamp 6, azimuth 216°, hue 216°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 0.0 12.0 30.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y 2.19911486
      translate -0.09404564 0.006502 -0.12944272
    }

  # Lamp 7, azimuth 252°, hue 252°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 6.0 0.0 30.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y 2.82743339
      translate -0.15216904 0.006502 -0.04944272
    }

  # Lamp 8, azimuth 288°, hue 288°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 24.0 0.0 30.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y 3.45575192
      translate -0.15216904 0.006502 0.04944272
    }

  # Lamp 9, azimuth 324°, hue 324°.
  object transformed
    object compound {
      object simple
        csg substraction {
          elem
            aabox 0.0015 0.01 0.07
            transform {
              translate 0.00025 0.0 0.0
            }
          elem
            aabox 0.004 0.0130 0.0730
            transform {
              translate 0.002 0.0 0.0
            }
        }
        lambertian color 0.9 0.9 0.9
      object transformed
        object simple
          rectangle 0.01 0.07
          diffuse_light color 30.0 0.0 18.0
        transform {
          rotate_z 1.57079633
          translate 0.0005 0.0 0.0
        }
    }
    transform {
      rotate_y 4.08407045
      translate -0.09404564 0.006502 0.12944272
    }
