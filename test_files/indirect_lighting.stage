# TODO : adujst geometry w/r to http://www.graphics.cornell.edu/online/box/data.html

# Approx Cornell Room
camera pin_hole
  pos 0.0 0.0 800.0
  look 0.0 0.0 0.0
  up 0.0 1.0 0.0

scene

  # lighting
  light point
    color 15.0 15.0 15.0
    transform {
      translate 0.0 2.0 1.0
    }

  # Ceiling
  object transformed
    object simple
      rectangle 555 555
      lambertian color 1.0 1.0 1.0
    transform {
      rotate_x -3.14159
      translate 0.0 277.0 0.0
    }
  # Floor
  object transformed
    object simple
      rectangle 555 555
      lambertian color 1.0 1.0 1.0
    transform {
      translate 0.0 -277.0 0.0
    }
  # Right
  object transformed
    object simple
      rectangle 555.0 555.0
      lambertian color 1.0 0 0
    transform {
      rotate_z -1.5708
      translate -277.0 0.0 0.0
    }
  # Left
  object transformed
    object simple
      rectangle 555.0 555.0
      lambertian color 0 1 0
    transform {
      rotate_z 1.5708
      translate 277.0 0.0 0.0
    }
  # Back
  object transformed
    object simple
      rectangle 555.0 555.0
      lambertian color 1 1 1
    transform {
      rotate_x 1.5708
      translate 0.0 0.0 -277.0
    }

  # blocker
  object transformed
    object simple
      aabox 300.0 10.0 300.0
      lambertian color 1 1 1
    transform {
      translate 0.0 100.0 0.0
    }

  # light
  object transformed
    object simple
      rectangle 130.0 105.0
      diffuse_light color 15.0 15.0 15.0
    transform {
#     A half turn about x aims the panel down, into the room. Emission is one-sided, so a panel
#     left facing the ceiling would be black.
      rotate_x 3.14159
      translate 0.0 276.0 0.0
    }
