# "Ray Tracing in One Weekend", final scene — 445 spheres.
#
# The `.stage` transcription of `examples/test_scene.rs`, whose 441 small spheres are drawn from an
# unseeded generator and therefore differ on every run. Frozen here, once, with the positions and
# materials of one draw (Python `random`, seed 20260820), so that the geometry is a property of the
# file rather than of the run. That is what makes it measurable: `bvh_stats` needs a scene whose
# tree is the same tree on every execution, and this is the only one the project has that holds
# more than eight primitives.
#
# The camera is the book's viewpoint. Its field of view comes from the `Config`, not from here, so
# `bvh_stats` frames it at the default 90° rather than the example's 20°.

camera pin_hole
  pos 13.0 2.0 3.0
  look 0.0 0.0 0.0
  up 0.0 1.0 0.0

scene
  # ground
  object transformed
    object simple
      sphere 1000.0
      lambertian checkerboard 0.2 0.3 0.1 0.9 0.9 0.9 2000.0
    transform { translate 0.0 -1000.0 0.0 }

  # the three large spheres
  object transformed
    object simple
      sphere 1.0
      dielectric 1.5 color 1.0 1.0 1.0
    transform { translate 0.0 1.0 0.0 }

  object transformed
    object simple
      sphere 1.0
      lambertian color 0.4 0.2 0.1
    transform { translate -4.0 1.0 0.0 }

  object transformed
    object simple
      sphere 1.0
      metal 0.0 color 0.7 0.6 0.5
    transform { translate 4.0 1.0 0.0 }

  # 21 x 21 small spheres
