camera pin_hole
  pos 0.0 1.0 1
  look 0.0 -2.0 -3.0
  up 0.0 1.0 0.0

scene

  # lighting
  light point
    color 15.0 15.0 15.0
    transform {
      translate 0.0 2.0 1.0
    }

  light background_infinite
    color 1.0 1.0 1.0
    color 0.5 0.7 1.0

  # simple sphere
  object transformed
    object simple
      sphere 1.0
      # dielectric 1.45 color 1 1 1
      lambertian color 1.0 0 0 
    transform {
      translate 0.0 0.0 0.0
    }

  # ground
  object transformed
    object simple
      rectangle 15 15
      lambertian checkerboard
        0.65 0.0 0.0
        0.65 0.65 0.65
        0.5
    transform {
      translate 0.0 -1.5 0.0
    }

  # # light source
  # object transformed
  #   object simple
  #     rectangle 1 1
  #     diffuse_light color 15.0 15.0 15.0
  #   transform {
  #     rotate_y 3.1416
  #     translate 0.0 5.0 0.0
  #   }
